{
  "expo": {
    "name": "WeCanRecall",
    "slug": "recalllens",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "recalllens",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.recalllens.app",
      "infoPlist": {
        "NSCameraUsageDescription": "WeCanRecall uses the camera to scan receipts and verify product lot numbers for recall matching."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#143D32",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["CAMERA"],
      "package": "com.recalllens.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#143D32"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow WeCanRecall to access your camera to scan receipts and verify product packages."
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
